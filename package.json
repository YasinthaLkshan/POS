{
  "name": "agripos",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "npm run dev:desktop",
    "dev:api": "npm run dev -w @agripos/api",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run packages apps/desktop/electron",
    "test:integration": "vitest run apps/api/tests",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "build": "npm run build:api && npm run build:desktop",
    "build:api": "npm run build -w @agripos/api",
    "build:desktop": "npm run build -w @agripos/desktop",
    "package:win": "npm run build:desktop && npm run package:win -w @agripos/desktop",
    "setup:admin": "tsx scripts/setup-admin.ts",
    "password:hash": "tsx scripts/hash-password.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "setup:check": "tsx scripts/check-setup.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
